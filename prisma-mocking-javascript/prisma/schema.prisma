generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = env("DATABASE_ENGINE")
  url      = env("DATABASE_URL")
}

model User {
  id                       Int     @id @default(autoincrement())
  email                    String  @unique
  name                     String?
  posts                    Post[]
  acceptTermsAndConditions Boolean
}

model Post {
  id      Int    @id @default(autoincrement())
  title   String
  content String
  author    User  @relation(fields: [authorId], references: [id])
  authorId  Int
}
